# Stripe (test mode keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CURRENCY=aed

# Local development URL (Stripe redirect URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session cookie domain — leave empty for localhost
SESSION_COOKIE_DOMAIN=
# HMAC signing for session cookies (prefer over NEXTAUTH_SECRET)
SESSION_SECRET=

# Optional — external API (not required for Stripe checkout)
NEXT_PUBLIC_API_BASE_URL=

# Auth persistence — required on Vercel/production. Locally, accounts are stored in
# .data/sooqna-auth-users.json (survives restart). Never use /tmp or memory.
DATABASE_URL=
# POSTGRES_URL=

# Cron endpoints (e.g. POST /api/cron/dispute-reminders). Required in production.
CRON_SECRET=

# Feature flags
NEXT_PUBLIC_ENABLE_UAE_PASS=false
NEXT_PUBLIC_ENABLE_EMAIL_OTP=false
NEXT_PUBLIC_ENABLE_GUEST_CHECKOUT=true
# Show mock-pay CTA in UI (dev/preview only)
NEXT_PUBLIC_ENABLE_MOCK_CHECKOUT=true
# Force server mock path even without Stripe (never set on production)
ALLOW_MOCK_CHECKOUT=false

# Email / OTP — required on Vercel for welcome + OTP mail
# Create a key at https://resend.com and verify sooqnauae.com (or keep the
# no-reply@sooqnauae.com from-address after DNS verification).
EMAIL_PROVIDER=resend
EMAIL_FROM_NAME=Sooqna | سوقنا
EMAIL_FROM_ADDRESS=no-reply@sooqnauae.com
RESEND_API_KEY=
SUPPORT_EMAIL=support@sooqnauae.com
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_PEPPER=sooqna-dev-pepper
ENABLE_DEMO_OTP=true
PASSWORD_PEPPER=sooqna-dev-password-pepper

# Web Push. Prefer setting both on Vercel (npx web-push generate-vapid-keys).
# If unset, the app persists a shared key pair in Postgres (app_vapid_keys).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional object storage (S3-compatible: AWS / Cloudflare R2 / MinIO)
# Falls back to durable local uploads served via /api/media when unset.
# S3_BUCKET=
# S3_REGION=me-central-1
# S3_ENDPOINT=                 # e.g. https://<account>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=false
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=          # CDN / public bucket base for listing media
# Never expose secret keys to the browser. Private evidence uses /api/media + signed GET.
